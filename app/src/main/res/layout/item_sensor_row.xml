<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_surface_card"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingTop="14dp"
    android:paddingRight="16dp"
    android:paddingBottom="14dp">

    <TextView
        android:id="@+id/sensorRowName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/phyphox_white_100"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/sensorRowMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/phyphox_white_60"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/sensorRowValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="monospace"
        android:textColor="@color/phyphox_primary_weak"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/sensorRowExtra"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/phyphox_white_70"
        android:textSize="12sp" />
</LinearLayout>
