<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/phyphox_black_80"
    android:clipToPadding="false"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/sensorDetailBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="12dp"
            android:text="@string/phyerma_back"
            android:textColor="@color/phyphox_primary_weak"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sensorDetailTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/phyphox_white_100"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sensorDetailChip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/phyphox_white_70"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/sensorDetailLive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="monospace"
            android:textColor="@color/phyphox_primary_weak"
            android:textSize="22sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/phyerma_section_quality"
            android:textColor="@color/phyphox_primary_weak"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sensorDetailStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:textColor="@color/phyphox_white_90"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/phyerma_section_meta"
            android:textColor="@color/phyphox_primary_weak"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sensorDetailMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/phyphox_white_90"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
